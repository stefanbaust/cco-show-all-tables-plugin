<?xml version="1.0" encoding="UTF-8"?>
<settings xmlns="http://maven.apache.org/SETTINGS/1.0.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.0.0
                              http://maven.apache.org/xsd/settings-1.0.0.xsd">

    <servers>
        <server>
            <id>CCO-Development</id>
            <username>stefanbaust-it</username>
            <password>${env.AZURE_SB_PERSONAL_ACCESS_TOKEN}</password>
        </server>
        <server>
            <id>github</id>
            <username>${env.GITHUB_ACTOR}</username>
            <password>${env.GITHUB_TOKEN}</password>
        </server>

    </servers>

    <profiles>
        <profile>
            <id>CCO-Development</id>
            <activation>
                <activeByDefault>true</activeByDefault>
            </activation>
            <repositories>
                <repository>
                    <id>CCO-Development</id>
                    <url>https://pkgs.dev.azure.com/stefanbaust-it/_packaging/CCO-Development/maven/v1</url>
                </repository>
            </repositories>
        </profile>
    </profiles>

</settings>
