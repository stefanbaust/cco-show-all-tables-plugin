<?xml version="1.0" encoding="UTF-8"?>
<settings xmlns="http://maven.apache.org/SETTINGS/1.0.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.0.0
                              http://maven.apache.org/xsd/settings-1.0.0.xsd">

    <servers>
        <!-- AWS CodeArtifact server -->
        <server>
            <id>cco-development-baust-cco-development</id>
            <username>aws</username>
            <password>${env.CODEARTIFACT_AUTH_TOKEN}</password>
        </server>

        <!-- GitHub Packages server -->
        <server>
            <id>github</id>
            <username>${env.GITHUB_ACTOR}</username>
            <password>${env.GITHUB_TOKEN}</password>
        </server>
    </servers>

    <profiles>
        <profile>
            <id>cco-development-baust-cco-development</id>
            <activation>
                <activeByDefault>true</activeByDefault>
            </activation>
            <repositories>
                <repository>
                    <id>cco-development-baust-cco-development</id>
                    <url>https://cco-development-baust-409431482697.d.codeartifact.eu-central-1.amazonaws.com/maven/cco-development/</url>
                </repository>
            </repositories>
        </profile>
    </profiles>

</settings>
